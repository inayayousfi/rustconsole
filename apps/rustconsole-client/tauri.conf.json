{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Console",
  "version": "0.1.0",
  "identifier": "org.rustconsole.client",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rust Console",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#111318"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../assets/icon.png", "../../assets/icon.ico"]
  }
}
